# Sao chép thành file `.env` và điền giá trị thật. Không commit `.env` lên git.

# ===== License (bắt buộc) =====
# URL server Laravel quản lý license (không có dấu / ở cuối)
COUPON_FINDER_LICENSE_SERVER_URL=http://127.0.0.1:8080
# Mã license do admin tạo trên server
COUPON_FINDER_LICENSE_KEY=

# ===== Apify (collector Google / Actor) =====
COUPON_FINDER_APIFY_TOKEN=

# Actor mặc định; đổi nếu bạn dùng Actor khác
# COUPON_FINDER_APIFY_ACTOR_ID=nFJndFXA5zjCTuudP

# Tiết kiệm Usage Apify (mặc định: 1 query, 1 trang Google, 5 kết quả organic)
# COUPON_FINDER_APIFY_MAX_PAGES_PER_QUERY=1
# COUPON_FINDER_APIFY_RESULTS_PER_PAGE=5
# True = 6+ query / run (tốn credit, kiểu cũ)
# COUPON_FINDER_APIFY_MULTI_QUERY=false

# Gộp vào MỘT câu Google khi apify_multi_query=false (OR site:retailmenot.com ...)
# COUPON_FINDER_APIFY_COUPON_SITE_DOMAINS=retailmenot.com,coupons.com,offers.com

# JSON merge thêm vào run_input Actor (tùy chọn, một dòng JSON hợp lệ)
# COUPON_FINDER_APIFY_RUN_INPUT_EXTRA_JSON={}

# ===== SerpAPI (tùy chọn) =====
COUPON_FINDER_SERPAPI_KEY=

# ===== Google Custom Search JSON API (tùy chọn) =====
COUPON_FINDER_GOOGLE_API_KEY=
COUPON_FINDER_GOOGLE_CSE_ID=

# ===== Chung =====
# COUPON_FINDER_EXTERNAL_SEARCH_MAX_RESULTS=10
# Playwright: headless=false + channel=chrome thường giúp qua Cloudflare (Simply Codes)
# COUPON_FINDER_HEADLESS=false
# COUPON_FINDER_PLAYWRIGHT_CHANNEL=chrome

# Verify: tự mở 1 trang sản phẩm và thử thêm vào giỏ trước khi nhập coupon (mỗi shop một URL sản phẩm ổn định)
# COUPON_FINDER_VERIFY_SEED_PRODUCT_URL=https://www.example.com/product/item-slug
# (tuỳ chọn) CSS nút Add to cart — nếu không set, tool thử vài pattern phổ biến + nút theo chữ
# COUPON_FINDER_VERIFY_SEED_ADD_TO_CART_CSS=button.single_add_to_cart_button
# Chờ sau khi bấm thêm giỏ (ms)
# COUPON_FINDER_VERIFY_SEED_WAIT_MS=2500

# Shopify (giai đoạn 1): verify mã qua Cart Ajax API trước khi fallback Playwright
# COUPON_FINDER_VERIFY_USE_SHOPIFY_CART_API=false
# COUPON_FINDER_VERIFY_SHOPIFY_PRODUCTS_LIMIT=20

# Chỉ giữ mã có source_url trên domain simplycodes.com (mặc định true). false = giữ mã từ SerpAPI / site khác
# COUPON_FINDER_FILTER_RAW_TO_SIMPLY_CODES_DOMAIN=false

# Chỉ thu thập từ Simply Codes (Apify + trang simplycodes.com), không dùng community / SerpAPI / Google CSE / Apify Google rộng
# COUPON_FINDER_ONLY_SIMPLY_CODES=true
